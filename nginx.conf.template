# Rendered at container start by the nginx image's entrypoint (envsubst).
# Only these are replaced (NGINX_ENVSUBST_FILTER in the Dockerfile), so
# nginx's own variables stay intact:
#   API_UPSTREAM           host:port of the API service (set by the Helm chart)
#   SENTRY_DSN             DSN of the webapp's errors (GlitchTip); empty: none sent
#   ERRORS_UPSTREAM        host:port of GlitchTip, a full name (the resolver
#                          does not use search domains)
#   ERRORS_PROJECT         its project id of the webapp
#   UMAMI_UPSTREAM         host:port of Umami, a full name (visit statistics)
#   UMAMI_WEBSITE_ID       its website id; empty: no tracker
#   NGINX_LOCAL_RESOLVERS  the pod's DNS servers (the image's entrypoint)
worker_processes auto;
events {
    worker_connections 1024;
    multi_accept on;
}
http {
    # No nginx version in Server headers and error pages.
    server_tokens off;

    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    gzip            on;
    gzip_static     on;
    gzip_vary       on;
    gzip_comp_level 6;
    # Below ~1 KiB gzip saves little and can grow the response.
    gzip_min_length 1024;
    # Also compress responses to requests that came through a proxy (the
    # ingress adds Via).
    gzip_proxied    any;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        application/wasm
        image/svg+xml
        font/ttf
        font/otf
        font/woff
        font/woff2;

    # ── Client IP ────────────────────────────────────────────────────────────
    # Behind the ingress, $remote_addr is the ingress pod. Take the client from
    # X-Forwarded-For, but only when the request came from inside the cluster,
    # so a client talking to nginx directly cannot spoof it. Narrow to the
    # cluster's pod CIDR in production.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # ── Rate limits (coarse first line; the API enforces exact per-user limits) ──
    # Credential endpoints only: other URIs map to an empty key, which nginx
    # does not count, so one location can carry both limits.
    map $uri $auth_limit_key {
        ~^/api/v1/auth/(login|register|refresh|token|impersonation)$     $binary_remote_addr;
        ~^/api/v1/connections/[^/]+/(authorize|callback)$                $binary_remote_addr;
        default                                                          "";
    }

    limit_req_zone $auth_limit_key     zone=auth:10m rate=20r/m;
    limit_req_zone $binary_remote_addr zone=api:10m  rate=30r/s;
    limit_conn_zone $binary_remote_addr zone=realtime:10m;
    limit_req_zone $binary_remote_addr zone=errors:10m rate=2r/s;
    limit_req_zone $binary_remote_addr zone=stats:10m rate=5r/s;

    # Host and port of the request's Origin, to compare with its Host: the
    # reports to /errors and /stats come from this webapp's own pages. A
    # browser always sends Origin with them; scripts can fake it, but pages
    # of other sites cannot post reports here.
    map $http_origin $origin_host {
        ~^https?://(?<origin_authority>[^/]+)$    $origin_authority;
        default                                   "";
    }

    limit_req_status  429;
    limit_conn_status 429;
    limit_req_log_level warn;

    server {
        listen 80;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # For ERRORS_UPSTREAM, looked up per request: without GlitchTip the
        # webapp still starts, /errors just fails.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        
		location /api/ {
			limit_req zone=auth burst=10 nodelay;
			limit_req zone=api  burst=60 nodelay;

			proxy_pass http://${API_UPSTREAM};
			proxy_http_version 1.1;
			
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
			
			proxy_set_header Connection "";
			
			proxy_connect_timeout 10s;
			proxy_send_timeout 30s;
			proxy_read_timeout 30s;

			# The server unreachable or too slow: nginx's own 502/504 become
			# the API's kind of error, which the webapp shows as an outage.
			# Errors the server itself returns pass through untouched (no
			# proxy_intercept_errors), its maintenance 503 included.
			error_page 502 504 = @api_unavailable;
		}

		# Files and the avatar: large bodies both ways. Uploads stream to the
		# server (which enforces the real limits) instead of being buffered
		# here, downloads stream back; the ceiling is the server's 1 GiB plus
		# the multipart framing. A regex, so it wins over /api/ for these.
		location ~ ^/api/v1/(files(/.*)?|auth/me/avatar)$ {
			limit_req zone=auth burst=10 nodelay;
			limit_req zone=api  burst=60 nodelay;
			client_max_body_size 1100m;

			proxy_pass http://${API_UPSTREAM};
			proxy_http_version 1.1;

			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;

			proxy_set_header Connection "";

			proxy_request_buffering off;
			proxy_buffering off;

			proxy_connect_timeout 10s;
			proxy_send_timeout 300s;
			proxy_read_timeout 300s;

			error_page 502 504 = @api_unavailable;
		}

		# The realtime gateway socket. Exact, so it wins over /api/ for this
		# path only: /api/v1/gateway/intents stays a plain API request.
		location = /api/v1/gateway {
			# Upgrade attempts count against the API rate; open sockets are capped.
			limit_req zone=api burst=60 nodelay;
			limit_conn realtime 20;

			proxy_pass http://${API_UPSTREAM};
			proxy_http_version 1.1;
			
			proxy_set_header Host $host;
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto $scheme;
			
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection "upgrade";
			
			proxy_connect_timeout 60s;
			proxy_send_timeout 60s;
			proxy_read_timeout 60s;
			
			proxy_buffering off;
			proxy_cache off;

			error_page 502 504 = @api_unavailable;
		}

		location @api_unavailable {
			default_type application/json;
			add_header Retry-After 30 always;
			add_header Cache-Control "no-store" always;
			return 503 '{"code":"Unavailable","message":"EchoPhase is not responding. Please try again shortly.","field":null}';
		}

		# What the webapp reads at start from the environment (no rebuild per
		# deployment): where its errors go, if anywhere.
		location = /config.json {
			default_type application/json;
			add_header Cache-Control "no-store" always;
			return 200 '{"sentryDsn":"${SENTRY_DSN}","umamiWebsiteId":"${UMAMI_WEBSITE_ID}"}';
		}

		# The browser's error reports (the Sentry SDK's tunnel) on to GlitchTip,
		# which needs no public address for them.
		location = /errors {
			if ($origin_host != $http_host) { return 403; }
			limit_req zone=errors burst=20 nodelay;
			client_max_body_size 1m;

			set $errors_upstream ${ERRORS_UPSTREAM};
			# ?sentry_key=: GlitchTip wants the DSN's key there; the SDK puts it
			# only in the body, so the webapp adds it to the tunnel's URL.
			proxy_pass http://$errors_upstream/api/${ERRORS_PROJECT}/envelope/$is_args$args;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_connect_timeout 5s;
			# GlitchTip's first report after a quiet spell takes several
			# seconds (warm ones: milliseconds); it is stored either way.
			proxy_read_timeout 30s;
		}
        
		# Umami (visit statistics) on the webapp's own origin: its tracker and
		# where it reports, forwarded; Umami needs no public address.
		location = /stats/script.js {
			set $stats_upstream ${UMAMI_UPSTREAM};
			proxy_pass http://$stats_upstream/script.js;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_connect_timeout 5s;
			proxy_read_timeout 10s;
		}

		location = /stats/api/send {
			if ($origin_host != $http_host) { return 403; }
			limit_req zone=stats burst=30 nodelay;
			client_max_body_size 64k;

			set $stats_upstream ${UMAMI_UPSTREAM};
			proxy_pass http://$stats_upstream/api/send;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			# The visitor's address (Umami derives the country, keeps no IP).
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_connect_timeout 5s;
			proxy_read_timeout 10s;
		}

        location ~* \.(js|css|woff2?|ttf|otf|svg|png|jpg|ico)$ {
            access_log off;
            expires 1y;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }
        
        location ~* \.map$ {
            add_header Cache-Control "no-store";
            try_files $uri =404;
        }
        
        # The app's shell (index.html, for every route): asked again each
        # time (a 304 while unchanged), so a deploy is seen at once. Without
        # it browsers guess a lifetime from Last-Modified and keep showing
        # the old build, whose hashed files may be gone.
        location / {
            add_header Cache-Control "no-cache" always;
            try_files $uri $uri/ /index.html;
        }
    }
}
