{
  "name": "webapp",
  "private": true,
  "version": "0.0.0",
  "description": "EchoPhase web client (the image tag is its version, see scripts/image-tag.sh)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "format": "prettier --write .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:api": "openapi-typescript ${OPENAPI:-artifacts/openapi.json} -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/lib/api/schema.d.ts",
    "format:check": "prettier --check ."
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.17"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false
  }
}
